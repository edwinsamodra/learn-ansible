# Ansible Inventory File
# Simpan file ini di: /home/vagrant/ansible/inventory/hosts

[all:vars]
ansible_user=vagrant
ansible_ssh_private_key_file=/home/vagrant/.ssh/id_rsa
ansible_python_interpreter=/usr/bin/python3

[nodes]
ansible-node1 ansible_host=192.168.56.3
ansible-node2 ansible_host=192.168.56.4
ansible-node3 ansible_host=192.168.56.5

[nodes:vars]
ansible_connection=ssh

[fe]
ansible-node1 ansible_host=192.168.56.3

[be]
ansible-node2 ansible_host=192.168.56.4

[db]
ansible-node3 ansible_host=192.168.56.5
